# agentic_downstream - see README.md for what this image is for, how to build it, and
# the gotchas behind the less obvious steps below.
#
# Thin layer over agentic_downstream_base.sif (agentic_downstream_base.def), which holds
# the system libraries and the full R/Bioconductor stack. This file adds only the
# fast-moving pieces - Node, the agent CLIs, managed settings, entrypoint.sh - so that
# changing any of them is a minutes-long rebuild, not the hour-plus R install. See
# README.md "Two-layer build".
#
# Build (BASE_IMAGE defaults to agentic_downstream_base.sif in the current directory):
#   apptainer build --fakeroot --build-arg BASE_IMAGE=/path/to/agentic_downstream_base_<ver>.sif \
#     agentic_downstream_<ver>.sif agentic_downstream.def
#
# Keep in sync with Dockerfile (identical package content).

Bootstrap: localimage
From: {{ BASE_IMAGE }}

%arguments
    BASE_IMAGE=agentic_downstream_base.sif

%files
    entrypoint.sh /usr/local/bin/entrypoint.sh

%labels
    org.opencontainers.image.title agentic_downstream
    org.opencontainers.image.description Seurat-free downstream single-cell analysis (SingleCellExperiment, UCell, DESeq2 pseudobulk DE, fgsea, SCPA, speckle/limma, harmony, ComplexHeatmap, survival modelling) plus claude/codex/agy (Antigravity) CLI agents for cluster-based agentic review workflows.
    org.opencontainers.image.source https://github.com/pirl-unc/singlecell_images
    org.opencontainers.image.base.name agentic_downstream_base
    org.opencontainers.image.vendor Benjamin Vincent Lab, UNC Lineberger

# Repeated verbatim from agentic_downstream_base.def: a derived image's %environment
# replaces the base's rather than adding to it, so dropping this line here would
# silently re-expose the host personal-R-library shadowing described there and in
# README.md "Gotchas".
#
# AGY_CLI_DISABLE_AUTO_UPDATE: agy updates itself in place by default, rewriting its
# own binary. That binary lives in the read-only image, so the update cannot land -
# at best wasted network calls, at worst a failed or stalled run. Rebuild this layer
# to pick up a new agy instead.
%environment
    export R_LIBS_USER="${HOME}/R/agentic_downstream/4.4"
    export AGY_CLI_DISABLE_AUTO_UPDATE=true

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    # %environment is not applied during %post, and the image is still writable
    # here - without this, the build's own `agy --version` gate could self-update
    # the binary mid-build to something the installer never checksummed.
    export AGY_CLI_DISABLE_AUTO_UPDATE=true
    chmod +x /usr/local/bin/entrypoint.sh

    # Node.js 20.x LTS via NodeSource. Ubuntu noble's apt `nodejs` (18.x) risks
    # compatibility issues with the agent CLIs below. curl/gnupg come from the base.
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get install -y nodejs
    rm -rf /var/lib/apt/lists/*

    # Agent CLIs. No user is switched: Apptainer maps the container process to the
    # invoking host user and binds that user's real $HOME at run time, so per-user
    # config/credential dirs (~/.claude, ~/.codex, ~/.npm) land in the actual host
    # home directory whether credentials come from an interactive OAuth login or an
    # API-key env var at batch-job time. Unpinned on purpose: these move fast, and
    # picking up the current release is the main reason to rebuild this layer.
    npm install -g \
        @anthropic-ai/claude-code \
        @openai/codex
    # codex's native binary ships as an OPTIONAL dependency
    # (@openai/codex-linux-x64, an alias of @openai/codex@<ver>-linux-x64, ~70 MB).
    # npm silently skips an optional dependency it fails to fetch, so a transient
    # registry error leaves codex.js with no binary and the build only fails later,
    # at `codex --version`, with "Missing optional dependency" (seen on 0.159.2).
    # Installing it by name, pinned to the version just installed, makes a failed
    # fetch a hard npm error here. It lands as a global sibling, which codex.js's
    # require.resolve finds.
    CODEX_VERSION="$(node -p "require('$(npm root -g)/@openai/codex/package.json').version")"
    npm install -g "@openai/codex-linux-x64@npm:@openai/codex@${CODEX_VERSION}-linux-x64"
    npm cache clean --force

    # Antigravity CLI (agy) - replaces @google/gemini-cli, which Google no longer
    # serves on the "Gemini Code Assist for individuals" tier. A single native
    # binary, not an npm package. Google's installer fetches the latest release
    # from a manifest and verifies its SHA-512 before installing. --dir puts it
    # system-wide rather than in the build user's ~/.local/bin. Its closing
    # `agy install` step edits shell profiles under $HOME, so HOME points at a
    # throwaway directory for the duration. Credentials and state land in
    # ~/.gemini/ at run time (see README.md "Subscription login for batch runs").
    curl -fsSL https://antigravity.google/cli/install.sh -o /tmp/agy_install.sh
    HOME=/tmp/agy_build_home bash /tmp/agy_install.sh --dir /usr/local/bin
    rm -rf /tmp/agy_install.sh /tmp/agy_build_home

    # Managed settings: denies rm/rmdir/unlink/shred for Claude Code regardless of
    # permission mode, including --dangerously-skip-permissions - managed settings
    # sit above every other settings source (project/.claude/settings.json, user
    # ~/.claude/settings.json, CLI flags) and nothing at runtime can override a
    # managed deny rule. Baked into the read-only image at
    # /etc/claude-code/managed-settings.json, so it also can't be edited away at
    # runtime even though the path itself would normally just need root to write,
    # not a read-only filesystem.
    # CAVEAT (see README.md "Security"): this is a match on the command TEXT Claude
    # usually writes, not an OS-level boundary - it stops the normal rm invocation,
    # not every conceivable way a subprocess could delete a file. The actual
    # boundary against deleting anything outside the intended directory is what's
    # bound writable at the Apptainer level (see README.md "Batch use" - don't bind
    # $HOME for batch jobs).
    mkdir -p /etc/claude-code
    cat > /etc/claude-code/managed-settings.json <<'MANAGED_SETTINGS'
{
  "permissions": {
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(shred *)"
    ]
  }
}
MANAGED_SETTINGS
    chmod 644 /etc/claude-code/managed-settings.json

    # Fatal gate - a broken npm install would otherwise only surface the first time
    # someone tries to launch an agent. The R gate lives in the base build.
    node --version
    npm --version
    claude --version
    codex --version
    agy --version

%test
    # The full per-package R check is the base image's %test (apptainer test
    # agentic_downstream_base_<ver>.sif) - the R stack here is that layer, unchanged.
    # This only confirms the base came through and the CLIs run.
    Rscript -e "library(SingleCellExperiment); library(SCPA); message('R ', getRversion(), ' | Bioc ', BiocManager::version())"
    node --version && npm --version && claude --version && codex --version && agy --version

# ENTRYPOINT_OVERRIDE runs a different launcher without a rebuild: bind the script in
# and point this at it. Invoked via bash, so the bound file needs no execute bit.
# Unset, the baked-in copy runs. See README.md "Testing an entrypoint change".
%runscript
    exec bash "${ENTRYPOINT_OVERRIDE:-/usr/local/bin/entrypoint.sh}" "$@"

%help
    Seurat-free downstream single-cell analysis: SingleCellExperiment, UCell, DESeq2,
    fgsea, SCPA, speckle/limma, scran/scater, harmony, ComplexHeatmap, survival
    modelling - plus claude/codex/agy (Antigravity) CLI agents for cluster-based agentic review
    workflows. See README.md in the image repo (github.com/pirl-unc/singlecell_images).

        # R work, same pattern as ../singlecell_downstream
        apptainer exec --bind /datastore,/home/$USER <image>.sif Rscript my_script.R
        apptainer exec --bind /datastore,/home/$USER <image>.sif R
        apptainer test <image>.sif

        # AGENTS: every agent launch needs --no-home --no-mount hostfs,cwd. Where the
        # site sets `mount hostfs = yes`, all host network filesystems are otherwise
        # mounted read-write whatever --bind/--no-home say, and the agents run with
        # permission checks off. entrypoint.sh refuses to start if they are exposed.
        # See README.md "Security".

        # Interactive agent login (bypasses %runscript) - bind only that agent's
        # credentials, e.g. agy:
        apptainer shell --cleanenv --no-home --no-mount hostfs,cwd \
          --bind "$HOME/.gemini:$HOME/.gemini" <image>.sif

        # Batch agent run: use agentic_run.sh from the image repo, which adds the
        # flags above, binds the agent's own credentials and context dirs read-only
        agentic_run.sh -i <image>.sif [-c /path/to/context] claude /path/to/prompt_dir

        # raw equivalent (claude needs both ~/.claude and ~/.claude.json)
        apptainer run --cleanenv --no-home --no-mount hostfs,cwd --bind /path/to/prompt_dir \
          --bind "$HOME/.claude:$HOME/.claude" --bind "$HOME/.claude.json:$HOME/.claude.json" \
          <image>.sif claude /path/to/prompt_dir

        # Test an edited entrypoint.sh with no rebuild
        agentic_run.sh -i <image>.sif -o /path/to/entrypoint.sh claude /path/to/prompt_dir
